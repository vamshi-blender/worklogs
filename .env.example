# Server-only OpenAI credentials. Never expose these to the extension.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Separate stateless model used to name new conversations.
OPENAI_TITLE_MODEL=gpt-5.6-luna

# SECURITY: ALLOWED_EXTENSION_ORIGINS and ENABLE_PRODUCTION_CHAT were removed
# in the commit that relaxed security for development. CORS is open to all
# origins (see lib/http/cors.ts) and there is no production kill-switch,
# authentication, or rate limiting. See that commit to bring them back.
