# Server-only OpenAI credentials. Never expose these to the extension.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Comma-separated exact extension origins shown in Donna's Settings panel.
# Example: chrome-extension://abcdefghijklmnopqrstuvwxyzabcdef
ALLOWED_EXTENSION_ORIGINS=

# Keep false until authentication, rate limiting, and durable pending-run
# storage are implemented.
ENABLE_PRODUCTION_CHAT=false
