# Server-only OpenAI credentials. Never expose these to the extension.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
# Separate stateless model used to name new conversations.
OPENAI_TITLE_MODEL=gpt-5.6-luna
# Separate stateless model used to distill reusable PMS knowledge.
OPENAI_MEMORY_MODEL=gpt-5.6-luna

# Server-only Supabase credentials. The service-role key bypasses RLS and must
# never be exposed to the Chrome extension or any NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Mem0 Platform credential.
MEM0_API_KEY=

# SECURITY: ALLOWED_EXTENSION_ORIGINS and ENABLE_PRODUCTION_CHAT were removed
# in the commit that relaxed security for development. CORS is open to all
# origins (see lib/http/cors.ts). Chat uses PMS bearer authentication, but
# there is no production rate limiting. See that commit to harden CORS again.
