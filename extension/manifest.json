{
  "manifest_version": 3,
  "name": "Workupdate AI",
  "description": "A starter Chrome extension chatbot powered by a Vercel-hosted OpenAI Agents SDK backend.",
  "version": "0.1.0",
  "action": {
    "default_title": "Workupdate AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "options_page": "options.html",
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "tabs"],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://*.vercel.app/*",
    "https://quixyhome.kwixee.co.in/*",
    "https://quixyhomeapi.kwixee.co.in/*"
  ]
}
