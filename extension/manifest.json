{
  "manifest_version": 3,
  "name": "Workupdate AI",
  "description": "A starter Chrome extension chatbot powered by a Vercel-hosted OpenAI Agents SDK backend.",
  "version": "0.1.0",
  "action": {
    "default_title": "Workupdate AI",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:3000/*", "https://*.vercel.app/*"]
}
